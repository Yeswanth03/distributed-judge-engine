# Copy to .env (git-ignored) and fill in what you need. docker compose reads .env from this folder.
# Never commit real secrets.

# ---- Sign in with Google / GitHub (User Service) ----
# A provider is enabled when both its ID and secret are set; the sign-in page then enables its button.
# After changing these: docker compose up -d user-service
#
# Google: https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID ->
#   Web application. Authorized redirect URI: http://localhost:8000/auth/oauth/google/callback
# GitHub: https://github.com/settings/developers -> New OAuth App.
#   Homepage URL: http://localhost:5500
#   Authorization callback URL: http://localhost:8000/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where browsers reach the gateway; provider callbacks are PUBLIC_BASE_URL/auth/oauth/{provider}/callback.
# PUBLIC_BASE_URL=http://localhost:8000

# ---- AI service: faster hints on a Mac ----
# Docker on a Mac can't use the GPU, so Ollama in Docker runs on the CPU (minutes per hint).
# Start the native Ollama app (it uses the GPU: seconds per hint), then uncomment this and run
#   docker compose up -d ai-service
# AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Ports already in use on your machine ----
# POSTGRES_PORT=5434
# CATALOG_PORT=8090
